# 1. CORE SERVER SETTINGS
FLASK_ENV=production
DEFENCE_PATH_SECRET_KEY=generate_a_cryptographically_secure_random_key_64_chars_min
PORT=5000

# 2. CANONICAL DOMAIN & SEO URLS
# Replace with your actual live production domain name (with https://)
CANONICAL_DOMAIN=https://defencepath.in
SITE_NAME="DEFENCE PATH"

# 3. SMTP EMAIL CONFIGURATION (Mandatory for OTP & Password Recovery)
# Use real Gmail App Password, Hostinger Titan Email, or SendGrid/AWS SES.
# For Gmail: Enable 2FA -> Go to https://myaccount.google.com/apppasswords -> Generate App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USER=your_verified_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM_EMAIL=your_verified_email@gmail.com
SMTP_FROM_NAME="DEFENCE PATH Command"

# 4. UPI PAYMENT & VERIFICATION SETTINGS
# Displayed to candidates for unlocking paid CBT Mock Tests
UPI_ID=pm204664-1@okaxis
UPI_NAME="Er. Prashant Mishra"
MOCK_TEST_PRICE=5.0
DEVELOPER_PHONE=6390314464

# 5. DATABASE SETTINGS (Default: SQLite persistent WAL mode)
# Database path relative to project root (default: defence_path.db)
DATABASE_PATH=defence_path.db
